# Copy this to .env and put your real key in — never commit .env.
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# Get a free key at https://openrouter.ai/keys (no credit card).
# The key starts with sk-or-v1- and is shown once — copy it straight
# into .env, no quotes needed, no spaces around the =.
OPENROUTER_API_KEY=sk-or-v1-paste-your-key-here

# Groq alternative (https://console.groq.com/keys). Only one key is
# needed — OpenRouter is the default. Uncomment to use Groq instead:
# GROQ_API_KEY=gsk_paste-your-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# Only OPENROUTER_API_KEY, GROQ_API_KEY and LLM_BASE_URL are ever read
# from .env. Any other line is ignored.
